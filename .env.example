# Database configuration
DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault

# Server configuration
PORT=4000
NODE_ENV=development

# Security: Master Key for per-file Data Encryption Key (DEK) wrapping (AES-256-GCM)
# MUST be 64 hexadecimal characters (32 bytes / 256 bits)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session secret for signing cookies
SESSION_SECRET=super_secret_session_signing_key_at_least_32_bytes_long_123456

# Allowed Frontend Origins (locked down; no wildcard)
CORS_ORIGIN=http://localhost:5173

# Cookie policy. Keep strict for same-origin/local development; use none for
# a Vercel frontend calling a separately hosted Render backend.
COOKIE_SAME_SITE=strict

# Storage path for encrypted blobs
STORAGE_DIR=./uploads
