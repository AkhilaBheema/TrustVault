# Database configuration
DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault

# First account created by `npm run db:seed` (required for an empty production database)
ORGANIZATION_NAME=Workspace
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Server configuration
PORT=4000
NODE_ENV=development

# Security: create a private 64-character hex key for AES-256-GCM DEK wrapping.
MASTER_KEY=

# Generate a private random session signing secret of at least 32 bytes.
SESSION_SECRET=

# Allowed Frontend Origins (locked down; no wildcard)
CORS_ORIGIN=http://localhost:5173

# Cookie policy. Keep strict; production API requests are proxied through Vercel
# so the browser sees the frontend and API as the same origin.
COOKIE_SAME_SITE=strict

# Storage path for encrypted blobs
STORAGE_DIR=./uploads
